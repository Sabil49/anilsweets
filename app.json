{
  "expo": {
    "name": "Anil Sweets Corner",
    "slug": "anil-sweets-corner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anilsweets.corner",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F0"
      },
      "package": "com.anilsweets.corner"
    },
    "scheme": "anilsweets",
    "extra": {
      "API_URL": "https://anilsweetbackend.vercel.app",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "587f68db-ffc5-4278-b545-f7da6cf66d46"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "useFrameworks": "static",
            "useModularHeaders": true
          }
        }
      ]
    ],
    "owner": "sabil10"
  }
}
