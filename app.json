{
  "expo": {
    "name": "Anil Sweets Corner",
    "slug": "anil-sweets-corner",
    "version": "1.0.0",
    "scheme": "anilsweets",
    "extra": {
      "API_URL": "https://anilsweetbackend.vercel.app",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d44f723a-dd79-4d02-ac9a-bcdc859deebf"
      }
    },
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "useModularHeaders": true
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.anilsweets.corner",
      "buildNumber": "8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.anilsweets.corner",
      "googleServicesFile": "./google-services.json"
    },
    "owner": "myzoapp8780"
  }
}
